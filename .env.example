# Copy to .env (gitignored) and fill in. Used by deploy.sh and scripts/metrics-pull.mjs.

# Cloudflare cache purge, run as the last step of deploy.sh.
#   Zone ID: dash.cloudflare.com → signal-to-noise.co → Overview (right column).
#   Token: My Profile → API Tokens → Create Token → Custom; scope it to the
#   signal-to-noise.co zone with the single permission Cache Purge: Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Cloudflare analytics read (scripts/metrics-pull.mjs) — separate token, Zone · Analytics · Read,
# scoped to signal-to-noise.co. The purge token above cannot read analytics.
CLOUDFLARE_ANALYTICS_TOKEN=
