# Build output
dist/
.output/

# Generated Open Graph cards — derived from public/img/*.webp by
# scripts/make-og-images.mjs, which prebuild runs on every build.
public/og/

# Dependencies
node_modules/

# Astro
.astro/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.production

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Agent tooling — local indexes/metadata, machine-specific
.serena/
.grok/
.claude/settings.local.json

# Watermarks-remover service — separate repo checkout, not site content
watermarks-remover/

# Personal reference material — keep locally, never commit
Linkedin Profile-self.pdf
*.resume.pdf
*.cv.pdf

# Source corpus for research (Buffett letters, etc.) — excerpts only land
# in published articles with attribution; the raw corpus stays out of git.
_sources/

# Autopilot runtime artifacts (see distribution/AUTONOMY.md).
# The queue/ items ARE committed (they're pre-approved content); these are
# per-run state that shouldn't churn git or leak across machines.
# (Comments must be on their own line — git ignores no inline trailing comments.)
# temp Substack hook files
.autopilot-hook-*.md
# local audit trail
distribution/autopilot/log.md
# kill-switch marker
distribution/autopilot/PAUSE
