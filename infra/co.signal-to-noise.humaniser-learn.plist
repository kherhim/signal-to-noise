<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.signal-to-noise.humaniser-learn</string>
  <!-- Weekly humaniser learn: reads the owner's edits, opens a PR of proposals,
       never merges. caffeinate as in the essay-line plist: a missed wake fires
       inside a short dark wake, too short for a headless Claude run.
       Monday 07:45, plus a daily 10:00 catch-up and a run at load; --scheduled
       runs it at most once per week and writes HEARTBEAT_HUMANISER_LEARN. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>-i</string>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/himanshu.kher/Documents/devProjects/signal2noise/scripts/line/humaniser-learn.mjs</string>
    <string>--scheduled</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/himanshu.kher/Documents/devProjects/signal2noise</string>
  <!-- claude (in ~/.local/bin), git and gh are spawned by name. -->
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/himanshu.kher/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key><string>/Users/himanshu.kher/Library/Logs/signal2noise-humaniser-learn.log</string>
  <key>StandardErrorPath</key><string>/Users/himanshu.kher/Library/Logs/signal2noise-humaniser-learn.log</string>
</dict>
</plist>
