<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.signal-to-noise.token-prices</string>
  <!-- Monthly token price snapshot: opens a PR with the new month's prices,
       never merges. 12:00 keeps clear of DeepSeek's weekday peak pricing
       (to 10:00 UTC), which the snapshot refuses. caffeinate as in the humaniser-learn plist: a missed wake
       fires inside a short dark wake. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>-i</string>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/himanshu.kher/Documents/devProjects/signal2noise/scripts/trackers/token-prices-monthly.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/himanshu.kher/Documents/devProjects/signal2noise</string>
  <!-- node, git and gh are spawned by name. -->
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/himanshu.kher/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/himanshu.kher/Library/Logs/signal2noise-token-prices.log</string>
  <key>StandardErrorPath</key><string>/Users/himanshu.kher/Library/Logs/signal2noise-token-prices.log</string>
</dict>
</plist>
