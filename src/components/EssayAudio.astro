---
/* Listen to the essay. Renders only when the page passes an AudioData entry
   whose hash matches the published text. A slim bar follows the reader once
   the panel scrolls away. Bound on astro:page-load, paused on astro:before-swap. */
interface AudioData { voice: string; engine: string; hash: string; file: string; duration: number; chapters: [string, number][]; peaks: number[] }
interface Props { data?: AudioData | null; title: string }
const { data, title } = Astro.props;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
---

{data && (
  <section class="ea" aria-label="Listen to this essay" data-ea>
    <audio preload="metadata" src={`/audio/${data.file}`}></audio>
    <div class="row">
      <button class="play" data-ea-play aria-label="Play"><svg viewBox="0 0 16 16"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg></button>
      <div class="meta">
        <div class="t">Listen to this essay · {Math.round(data.duration / 60)} min</div>
        <span class="label" title="Read aloud by a synthetic voice generated by AI from the published text."><svg viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" /><path d="M6 5.2v3.3M6 3.4v.1" stroke="currentColor" stroke-linecap="round" /></svg>AI-narrated</span>
      </div>
      <button class="skip back" data-ea-skip="-15" aria-label="Back 15 seconds">−15</button>
      <button class="skip" data-ea-skip="15" aria-label="Forward 15 seconds">+15</button>
      <button class="speed" data-ea-speed aria-label="Playback speed">1×</button>
    </div>
    <div class="track" data-ea-track role="slider" tabindex="0" aria-label="Position in the essay" aria-valuemin="0" aria-valuemax={Math.round(data.duration)} aria-valuenow="0"><canvas></canvas></div>
    <div class="times"><span data-ea-cur>0:00</span><span class="chap" data-ea-chap>{data.chapters[0][0]}</span><span data-ea-left>−{fmt(data.duration)}</span></div>
    <details class="chapters">
      <summary>Sections</summary>
      <ol>
        {data.chapters.map(([name, s]) => (
          <li><button data-ea-seek={s}><span>{name}</span><span>{fmt(s)}</span></button></li>
        ))}
      </ol>
    </details>
    <script type="application/json" data-ea-data set:html={JSON.stringify(data)} />
  </section>
)}
{data && (
  <div class="ea-mini" data-ea-mini aria-hidden="true">
    <div class="bar" data-ea-bar></div>
    <div class="in">
      <button class="play" data-ea-play aria-label="Play" tabindex="-1"><svg viewBox="0 0 16 16"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg></button>
      <div class="m"><b>{title}</b><span data-ea-mchap>{data.chapters[0][0]}</span> · <span data-ea-mcur>0:00</span> / {fmt(data.duration)} · AI-narrated</div>
      <button class="speed" data-ea-speed tabindex="-1">1×</button>
    </div>
  </div>
)}

<style>
  .ea { margin: 0 0 40px; background: #121214; border: 1px solid rgb(63 63 70 / 0.7); border-radius: 10px; padding: 16px 18px 14px; }
  .row { display: flex; align-items: center; gap: 14px; }
  .play { width: 48px; height: 48px; flex: none; border-radius: 50%; background: var(--color-fg); color: #0a0a0a; display: grid; place-items: center; transition: transform .15s; }
  .play:hover { transform: scale(1.05); }
  .play svg { width: 18px; height: 18px; }
  .meta { min-width: 0; flex: 1; }
  .t { font-weight: 600; font-size: 15px; line-height: 1.3; color: var(--color-fg); }
  .label { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-muted); border: 1px solid var(--color-divider); border-radius: 999px; padding: 2px 9px 2px 7px; margin-top: 6px; line-height: 1.5; cursor: help; }
  .label svg { width: 12px; height: 12px; }
  .skip { font-size: 12px; color: var(--color-muted); width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--color-divider); display: grid; place-items: center; flex: none; font-variant-numeric: tabular-nums; }
  .speed { font-size: 13px; color: var(--color-muted); border: 1px solid var(--color-divider); border-radius: 6px; padding: 4px 8px; min-width: 52px; font-variant-numeric: tabular-nums; flex: none; }
  .skip:hover, .speed:hover { color: var(--color-fg); border-color: var(--color-muted); }
  @media (max-width: 520px) { .skip.back { display: none; } }
  .track { position: relative; margin: 16px 0 4px; height: 34px; cursor: pointer; touch-action: none; }
  .track canvas { width: 100%; height: 100%; display: block; }
  .track:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 3px; border-radius: 4px; }
  .times { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: #64707e; font-variant-numeric: tabular-nums; }
  .chap { color: var(--color-muted); text-align: center; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  details { margin-top: 10px; border-top: 1px solid rgb(63 63 70 / 0.6); padding-top: 8px; }
  summary { font-size: 13px; color: var(--color-muted); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "▸ "; }
  details[open] summary::before { content: "▾ "; }
  ol { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 2px; }
  li button { width: 100%; display: flex; justify-content: space-between; gap: 12px; text-align: left; font-size: 14px; padding: 5px 8px; border-radius: 6px; color: var(--color-muted); }
  li button:hover, li button.on { background: #1a1a1d; color: var(--color-fg); }
  li span:last-child { font-variant-numeric: tabular-nums; color: #64707e; }

  .ea-mini { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: rgb(18 18 20 / 0.94); backdrop-filter: blur(10px); border-top: 1px solid rgb(63 63 70 / 0.8); transform: translateY(110%); transition: transform .25s; padding-bottom: env(safe-area-inset-bottom, 0px); }
  .ea-mini.show { transform: none; }
  .ea-mini .in { max-width: 720px; margin: 0 auto; display: flex; align-items: center; gap: 12px; padding: 10px 24px; }
  .ea-mini .play { width: 36px; height: 36px; }
  .ea-mini .play svg { width: 13px; height: 13px; }
  .m { flex: 1; min-width: 0; font-size: 13px; color: var(--color-muted); }
  .m b { display: block; font-weight: 600; color: var(--color-fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar { position: absolute; left: 0; top: -1px; height: 2px; background: #d8d2c4; width: 0; }
  :global(.prose h2.ea-reading) { color: #d8d2c4; }
  @media (prefers-reduced-motion: reduce) { .ea-mini, .play { transition: none; } }
</style>

<script>
  const PLAY = 'M4 2.5v11l9-5.5z', PAUSE = 'M4 2.5h3v11H4zM9 2.5h3v11H9z';
  const RATES = [1, 1.25, 1.5, 0.75];
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  let stop: (() => void) | null = null;

  function mount() {
    stop?.();
    const root = document.querySelector<HTMLElement>('[data-ea]');
    if (!root) return;
    const mini = document.querySelector<HTMLElement>('[data-ea-mini]')!;
    const audio = root.querySelector('audio')!;
    /* After a view-transition swap Chrome can leave the element in an error state (the load was started in the parsed, inert document); reload once adopted. */
    if (audio.error) audio.load();
    const { duration, chapters, peaks } = JSON.parse(root.querySelector('[data-ea-data]')!.textContent || '{}') as { duration: number; chapters: [string, number][]; peaks: number[] };
    const q = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel), ...mini.querySelectorAll<T>(sel)];
    const one = (sel: string) => (root.querySelector(sel) ?? mini.querySelector(sel)) as HTMLElement;
    const track = one('[data-ea-track]'), cv = track.querySelector('canvas')!, ctx = cv.getContext('2d')!;
    const heads = [...document.querySelectorAll<HTMLElement>('.prose h2')];
    const total = () => (isFinite(audio.duration) ? audio.duration : duration);
    const chapterAt = (s: number) => { let i = 0; chapters.forEach(([, c], k) => { if (s >= c) i = k; }); return i; };

    function draw() {
      const dpr = devicePixelRatio || 1, r = cv.getBoundingClientRect();
      cv.width = r.width * dpr; cv.height = r.height * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const W = r.width, H = r.height, n = peaks.length, bw = W / n, p = audio.currentTime / total();
      ctx.clearRect(0, 0, W, H);
      peaks.forEach((v, i) => {
        const h = Math.max(2, Math.sqrt(v) * (H - 6));
        ctx.fillStyle = i / n < p ? '#d8d2c4' : '#3f424a';
        ctx.fillRect(i * bw + 0.5, (H - h) / 2, Math.max(1, bw - 1.5), h);
      });
      ctx.fillStyle = '#64707e';
      chapters.slice(1).forEach(([, s]) => ctx.fillRect((s / total()) * W - 0.5, 0, 1, 5));
    }
    function render() {
      const t = audio.currentTime, i = chapterAt(t), playing = !audio.paused;
      one('[data-ea-cur]').textContent = fmt(t); one('[data-ea-mcur]').textContent = fmt(t);
      one('[data-ea-left]').textContent = `−${fmt(Math.max(0, total() - t))}`;
      one('[data-ea-chap]').textContent = chapters[i][0]; one('[data-ea-mchap]').textContent = chapters[i][0];
      one('[data-ea-bar]').style.width = `${(t / total()) * 100}%`;
      track.setAttribute('aria-valuenow', String(Math.round(t))); track.setAttribute('aria-valuetext', `${fmt(t)}, ${chapters[i][0]}`);
      q<HTMLButtonElement>('[data-ea-seek]').forEach((b, k) => b.classList.toggle('on', k === i));
      heads.forEach((h, k) => h.classList.toggle('ea-reading', playing && k === i - 1));
      q<HTMLButtonElement>('[data-ea-play]').forEach((b) => { b.querySelector('path')!.setAttribute('d', playing ? PAUSE : PLAY); b.setAttribute('aria-label', playing ? 'Pause' : 'Play'); });
      draw();
    }
    const seek = (s: number) => { audio.currentTime = Math.max(0, Math.min(total(), s)); render(); };
    const toggle = () => (audio.paused ? audio.play() : audio.pause());
    const fromX = (x: number) => { const r = track.getBoundingClientRect(); seek(((x - r.left) / r.width) * total()); };

    const offs: (() => void)[] = [];
    const on = (el: EventTarget, ev: string, fn: (e: any) => void) => { el.addEventListener(ev, fn); offs.push(() => el.removeEventListener(ev, fn)); };
    q('[data-ea-play]').forEach((b) => on(b, 'click', toggle));
    q<HTMLElement>('[data-ea-skip]').forEach((b) => on(b, 'click', () => seek(audio.currentTime + Number(b.dataset.eaSkip))));
    q<HTMLElement>('[data-ea-seek]').forEach((b) => on(b, 'click', () => { seek(Number(b.dataset.eaSeek)); audio.play(); }));
    q<HTMLButtonElement>('[data-ea-speed]').forEach((b) => on(b, 'click', () => {
      audio.playbackRate = RATES[(RATES.indexOf(audio.playbackRate) + 1) % RATES.length];
      q('[data-ea-speed]').forEach((x) => (x.textContent = `${audio.playbackRate}×`));
    }));
    on(track, 'pointerdown', (e: PointerEvent) => { track.setPointerCapture(e.pointerId); fromX(e.clientX); });
    on(track, 'pointermove', (e: PointerEvent) => { if (e.buttons) fromX(e.clientX); });
    on(track, 'keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') seek(audio.currentTime + 5);
      if (e.key === 'ArrowLeft') seek(audio.currentTime - 5);
      if (e.key === ' ') { e.preventDefault(); toggle(); }
    });
    for (const ev of ['timeupdate', 'play', 'pause', 'loadedmetadata', 'ended']) on(audio, ev, render);
    on(window, 'resize', draw);
    const io = new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0 && audio.currentTime > 0;
      mini.classList.toggle('show', show); mini.setAttribute('aria-hidden', String(!show));
      mini.querySelectorAll<HTMLElement>('button').forEach((b) => (b.tabIndex = show ? 0 : -1));
    });
    io.observe(root);
    render();

    stop = () => { audio.pause(); io.disconnect(); offs.forEach((f) => f()); stop = null; };
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
