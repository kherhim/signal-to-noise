---
/* Subscribe CTA — the LinkedIn newsletter is the only subscription (Substack
   was retired on 29 Sep 2026).

   framed (default true): the bordered article-end variant that matches
   ShareLinks / Related insights. Pass framed={false} on pages that provide
   their own header (e.g. /subscribe). */
interface Props {
  framed?: boolean;
}

const { framed = true } = Astro.props;
const LINKEDIN_NEWSLETTER =
  'https://www.linkedin.com/newsletters/signal-to-noise-7490249039209271296/';
---

<aside
  class:list={[framed && 'mt-16 pt-8 border-t border-divider/60']}
  aria-label="Subscribe to the newsletter"
>
  {framed && (
    <>
      <p class="text-sm uppercase tracking-widest text-muted mb-4">Subscribe</p>
      <p class="text-sm text-muted leading-relaxed mb-5 max-w-[52ch]">
        New essays every couple of weeks, where you already read — the
        Signal&nbsp;to&nbsp;Noise newsletter on LinkedIn.
      </p>
    </>
  )}
  {framed ? (
    <a
      href={LINKEDIN_NEWSLETTER}
      rel="noopener"
      target="_blank"
      class="inline-block px-5 py-2.5 rounded-lg border border-accent text-accent hover:text-accent-hover hover:border-accent-hover transition-colors text-sm font-medium"
    >Subscribe on LinkedIn →</a>
  ) : (
    <div class="space-y-6 not-prose">
      <div class="p-6 sm:p-8 rounded-lg border border-divider/60 bg-surface/40">
        <p class="text-xs uppercase tracking-widest text-muted mb-2">On LinkedIn</p>
        <p class="text-base text-fg leading-relaxed mb-5 max-w-[52ch]">
          Every edition reaches you by notification and email, where you
          already read. One click, no forms.
        </p>
        <a
          href={LINKEDIN_NEWSLETTER}
          rel="noopener"
          target="_blank"
          class="inline-block px-5 py-2.5 rounded-lg border border-accent text-accent hover:text-accent-hover hover:border-accent-hover transition-colors text-sm font-medium"
        >Subscribe on LinkedIn →</a>
      </div>
    </div>
  )}
</aside>
