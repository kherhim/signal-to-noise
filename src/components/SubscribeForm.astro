---
/* Email signup. Posts to the Cloudflare Worker at /api/subscribe, which
   calls Beehiiv. Works as a normal form when JavaScript is off; the script
   only keeps the result on the page. LinkedIn and RSS stay secondary.
   location is stored on the subscriber (post-footer, subscribe-page, homepage). */
interface Props {
  location: 'post-footer' | 'subscribe-page' | 'homepage';
  framed?: boolean;
}

const { location, framed = true } = Astro.props;
const inputId = `subscribe-email-${location}`;
const LINKEDIN_NEWSLETTER =
  'https://www.linkedin.com/newsletters/signal-to-noise-7490249039209271296/';
---

<aside
  id={location === 'homepage' ? 'newsletter' : undefined}
  class:list={[framed && 'mt-16 pt-8 border-t border-divider/60']}
  aria-label="Subscribe to the newsletter"
>
  {location !== 'subscribe-page' && (
    <p class="text-sm uppercase tracking-widest text-muted mb-4">Subscribe</p>
  )}
  <p class="text-sm text-muted leading-relaxed mb-5 max-w-[52ch]">
    Leave your email to join the list. Nothing is sent for now; the essays stay here and on LinkedIn.
  </p>
  <form data-subscribe action="/api/subscribe" method="post" class="max-w-[40rem]">
    <input type="hidden" name="location" value={location} />
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_term" value="" />
    <input type="hidden" name="utm_content" value="" />
    <div class="hp" aria-hidden="true">
      <label>
        Company website
        <input name="company_website" type="text" tabindex="-1" autocomplete="off" value="" />
      </label>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for={inputId}>Email address</label>
      <input
        id={inputId}
        class="flex-1 min-w-0 px-4 py-2.5 rounded-lg border border-divider bg-canvas text-fg text-base placeholder:text-muted focus:outline-none focus:border-accent"
        type="email"
        name="email"
        required
        maxlength="254"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        placeholder="you@company.com"
      />
      <button
        class="px-5 py-2.5 rounded-lg bg-accent text-canvas text-sm font-medium hover:shadow-[0_0_28px_rgba(255,255,255,0.3)] transition-all disabled:opacity-60"
        type="submit"
      >Subscribe</button>
    </div>
    <p data-subscribe-status class="text-sm text-muted mt-3 min-h-[1.25rem]" role="status"></p>
  </form>
  <p class="text-sm text-muted">
    <a
      href={LINKEDIN_NEWSLETTER}
      rel="noopener"
      target="_blank"
      class="text-accent hover:text-accent-hover transition-colors"
    >Also on LinkedIn</a>
    <span aria-hidden="true"> · </span>
    <a href="/rss.xml" class="text-accent hover:text-accent-hover transition-colors">RSS</a>
  </p>
</aside>

<style>
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

  function fillUtms(form: HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);
    for (const key of UTM_KEYS) {
      const input = form.querySelector<HTMLInputElement>(`input[name="${key}"]`);
      const value = params.get(key);
      if (input && value) input.value = value.slice(0, 200);
    }
  }

  function bindSubscribe(form: HTMLFormElement) {
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    fillUtms(form);
    form.addEventListener('submit', async (event) => {
      if (!window.fetch || !window.FormData) return;
      event.preventDefault();
      fillUtms(form);
      const status = form.querySelector<HTMLElement>('[data-subscribe-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      if (status) status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => null);
        const message = data?.message || 'Something went wrong. Try again in a moment.';
        if (status) status.textContent = message;
        if (!data?.ok && button) button.disabled = false;
      } catch {
        if (status) status.textContent = 'Something went wrong. Try again in a moment.';
        if (button) button.disabled = false;
      }
    });
  }

  function setupSubscribe() {
    document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach(bindSubscribe);
  }

  document.addEventListener('astro:page-load', setupSubscribe);
</script>
