---
/* Four live numbers from the trackers, computed at build time from their data. */
import hs from '../../data/hyperscalers/quarters.json';
import { prepare, tiles } from '../../lib/hyperscalers.mjs';

const snaps = import.meta.glob('../../data/token-prices/snapshots/*.json', { eager: true, import: 'default' });
const snap = snaps[Object.keys(snaps).sort().at(-1)];
const median = (xs) => { const v = [...xs].sort((a, b) => a - b); const m = Math.floor(v.length / 2); return v.length % 2 ? v[m] : (v[m - 1] + v[m]) / 2; };
const tier = (k) => median(snap.labs.filter((l) => l[k]).map((l) => l[k].blended));
const rows = prepare(hs);
const t = tiles(rows);

const TOKENS = { href: '/trackers/ai-token-prices', name: 'Token index' };
const CASH = { href: '/trackers/hyperscaler-cash', name: 'Hyperscaler cash' };
const cells = [
  { k: 'Flagship AI model', v: `$${tier('flagship').toFixed(2)}`, s: 'median price per million tokens', link: TOKENS },
  { k: 'Budget AI model', v: `$${tier('budget').toFixed(2)}`, s: 'median price per million tokens', link: TOKENS },
  { k: 'AI capex against cash flow', v: `${Math.round(t.capexShare * 100)}%`, s: `${rows.length} hyperscalers, last four quarters`, link: CASH },
  { k: 'Negative free cash flow', v: `${t.negative.length} of ${rows.length}`, s: 'hyperscalers, latest quarter', link: CASH },
];
---

<section class="strip" aria-label="From the trackers">
  <div class="mx-auto max-w-[1100px] px-6 cells">
    {cells.map((c) => (
      <div class="num">
        <span class="k">{c.k}</span>
        <span class="v">{c.v}</span>
        <span class="s">{c.s} · <a href={c.link.href}>{c.link.name}</a></span>
      </div>
    ))}
  </div>
</section>

<style>
  .strip { border-block: 1px solid rgb(63 63 70 / 0.6); }
  .cells { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .num { display: flex; flex-direction: column; gap: 2px; padding: 22px 18px 20px; border-left: 1px solid rgb(63 63 70 / 0.6); }
  .num:first-child { border-left: 0; padding-left: 0; }
  .k { font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  .v { font-family: var(--font-display); font-size: 34px; font-weight: 600; line-height: 1.1; color: var(--color-fg); font-variant-numeric: tabular-nums; }
  .s { font-size: 13px; color: var(--color-muted); }
  .s a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-divider); }
  .s a:hover { color: var(--color-fg); }
  @media (max-width: 760px) {
    .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .num { padding: 18px 12px 16px 14px; }
    .num:nth-child(odd) { border-left: 0; padding-left: 0; }
    .num:nth-child(-n+2) { border-bottom: 1px solid rgb(63 63 70 / 0.6); }
  }
</style>
