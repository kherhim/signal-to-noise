---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import ShareLinks from '../components/ShareLinks.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import AnimatedCover from '../components/AnimatedCover.astro';
import EssayAudio from '../components/EssayAudio.astro';
import { AUTHOR, SITE_URL, WEBSITE, ogImagePath } from '../lib/schema';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

interface AudioData { voice: string; engine: string; hash: string; file: string; duration: number; chapters: [string, number][]; peaks: number[] }

interface Props {
  title: string;
  date: Date;
  /* Substantive revision date; shown and used for dateModified when later than date. */
  updated?: Date;
  excerpt: string;
  /* Search-intent meta description; falls back to excerpt when absent. */
  seoDescription?: string;
  tags?: string[];
  /* Optional cover image rendered above the header. */
  coverImage?: string;
  coverImageAlt?: string;
  /* Optional animated cover; replaces the <img> on the essay page only. */
  coverAnimation?: string;
  /* Series support — set when this post is part of a multi-part series.
     Kicker text shows above the title (linked to parent for children).
     Parts list renders at the article end for the parent only. */
  seriesKicker?: string;
  seriesKickerHref?: string;
  seriesParts?: { href: string; label: string; part: number }[];
  /* Series children only: the series this part belongs to, for JSON-LD. */
  series?: { name: string; href?: string };
  /* Related insights — 2-3 posts sharing tags with this one, rendered
     at the article end. Computed at the page level. */
  related?: { href: string; title: string; excerpt: string; date: Date }[];
  /* Narration entry, already hash-checked against the text; null hides the player. */
  audio?: AudioData | null;
}

const {
  title,
  date,
  updated,
  excerpt,
  seoDescription,
  tags = [],
  coverImage,
  coverImageAlt,
  coverAnimation,
  seriesKicker,
  seriesKickerHref,
  seriesParts,
  series,
  related = [],
  audio = null,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/* JSON-LD: the essay as a BlogPosting by the site's Person, plus a
   Home → Insights → essay breadcrumb. */
const revised = updated && updated.getTime() > date.getTime() ? updated : undefined;
const dateModified = revised ?? date;
const isPartOf: Record<string, unknown>[] = [{ '@id': WEBSITE['@id'] }];
if (series) {
  isPartOf.push({
    '@type': 'CreativeWorkSeries',
    name: series.name,
    ...(series.href ? { url: new URL(series.href.replace(/\/?$/, '/'), SITE_URL).toString() } : {}),
  });
}
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: seoDescription ?? excerpt,
    datePublished: date.toISOString(),
    dateModified: dateModified.toISOString(),
    author: { '@id': AUTHOR['@id'] },
    publisher: { '@id': AUTHOR['@id'] },
    image: new URL(ogImagePath(coverImage), SITE_URL).toString(),
    mainEntityOfPage: canonicalUrl,
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
    isPartOf: isPartOf.length === 1 ? isPartOf[0] : isPartOf,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: `${SITE_URL}/insights/` },
      { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={`${title} — Himanshu Kher`}
  socialTitle={title}
  description={seoDescription ?? excerpt}
  ogImage={coverImage}
  ogType="article"
  starsDim
  preloadImage={coverAnimation ? undefined : coverImage}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[720px] px-6 py-16 sm:py-24">
    {coverAnimation ? (
      <figure class="mb-10">
        <AnimatedCover kind={coverAnimation} alt={coverImageAlt} />
      </figure>
    ) : coverImage && (
      <figure class="mb-10">
        <img
          src={coverImage}
          alt={coverImageAlt ?? ''}
          loading="eager"
          class="w-full h-auto rounded-lg border border-divider/60"
        />
      </figure>
    )}

    {/* Site search (scripts/build-search-index.mjs) indexes this region only:
        the header and the essay text, not the share, subscribe or related
        blocks below. The hidden spans hand the results page its metadata. */}
    <div data-pagefind-body>
    <span hidden data-pagefind-filter="type:essay"></span>
    <span hidden data-pagefind-meta={`date:${formatted}`}></span>
    {coverImage && <span hidden data-pagefind-meta={`image:${coverImage}`}></span>}
    <header class="mb-12">
      {seriesKicker && (
        <p class="text-sm uppercase tracking-widest text-accent mb-6">
          {seriesKickerHref ? (
            <a href={seriesKickerHref} class="hover:underline underline-offset-4">
              {seriesKicker}
            </a>
          ) : (
            seriesKicker
          )}
        </p>
      )}

      <p data-pagefind-ignore class="text-sm text-muted mb-3">
        <time datetime={date.toISOString()}>{formatted}</time>
        {revised && (
          <>
            <span aria-hidden="true"> · </span>
            <span>Updated <time datetime={revised.toISOString()}>{fmt(revised)}</time></span>
          </>
        )}
      </p>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight text-fg">
        {title}
      </h1>
      <div data-pagefind-ignore class="flex items-center gap-3 mt-5 text-sm text-muted">
        <img
          src="/img/himanshu-portrait.webp"
          alt="Himanshu Kher"
          width="32"
          height="32"
          loading="eager"
          class="w-8 h-8 rounded-full object-cover border border-divider/60 shrink-0"
        />
        <p class="leading-snug">
          By <a href="/about/" rel="author" class="font-semibold text-fg hover:text-accent transition-colors">Himanshu Kher</a>
          <span class="block text-xs">CFO · 25+ years in finance and strategy</span>
        </p>
      </div>
      {tags.length > 0 && (
        <ul data-pagefind-ignore class="flex flex-wrap gap-2 mt-6">
          {tags.map((t) => (
            <li>
              <a
                href={`/insights/tag/${t}/`}
                class="inline-block text-xs uppercase tracking-wide text-muted px-2 py-1 border border-divider rounded hover:text-accent hover:border-accent/40 transition-colors"
              >
                {t}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div data-pagefind-ignore><EssayAudio data={audio} title={title} /></div>

    <Prose>
      <slot />
    </Prose>
    </div>

    <ShareLinks url={canonicalUrl} title={title} />

    <SubscribeForm />

    {seriesParts && seriesParts.length > 0 && (
      <section class="mt-16 pt-8 border-t border-divider/60">
        <p class="text-sm uppercase tracking-widest text-muted mb-6">
          The {seriesParts.length} parts
        </p>
        <ol class="space-y-3">
          {seriesParts.map((p) => (
            <li class="flex items-baseline gap-4">
              <span class="text-muted text-xs uppercase tracking-wide w-16 shrink-0">
                Part {p.part}
              </span>
              <a
                href={p.href}
                class="text-fg hover:text-accent transition-colors"
              >
                {p.label}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <aside
        class="mt-16 pt-8 border-t border-divider/60"
        aria-labelledby="related-heading"
      >
        <h2
          id="related-heading"
          class="text-sm uppercase tracking-widest text-accent mb-6"
        >
          Related insights
        </h2>
        <ul class="space-y-8">
          {related.map((r) => (
            <li>
              <article class="group">
                <time
                  class="text-xs text-muted block mb-2"
                  datetime={r.date.toISOString()}
                >
                  {fmt(r.date)}
                </time>
                <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-fg mb-2 group-hover:text-accent transition-colors">
                  <a href={r.href}>{r.title}</a>
                </h3>
                <p class="text-sm text-muted leading-relaxed">{r.excerpt}</p>
              </article>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>
