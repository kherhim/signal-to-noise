---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TrackerStrip from '../components/home/TrackerStrip.astro';
import ThemeRail from '../components/home/ThemeRail.astro';
import { homepagePlan, themeOf } from '../lib/themes.mjs';

// In dev, show drafts so you can preview them; in prod, drafts stay hidden.
const allInsights = (await getCollection(
  'insights',
  ({ data }) => import.meta.env.DEV || !data.draft,
)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Series children don't surface independently on the homepage — they hang
// from their parent on the insights page instead.
const homepageCandidates = allInsights.filter((i) => i.data.series?.part === undefined);

/* Featured pick — three-tier priority:
   1. Fresh: latest article published in the last 7 days (so adding a
      new article and rebuilding always promotes it to the featured slot)
   2. Manual: any article with featured: true in frontmatter
   3. Weekly rotation: deterministic by current week-of-epoch, so the
      featured slot rotates automatically when nothing fresh is around.
   Rotation is computed at build time — to actually rotate weekly, the
   site needs to be rebuilt at least weekly (a cron job can handle this). */
function pickFeatured(candidates: typeof homepageCandidates) {
  if (candidates.length === 0) return undefined;

  const ONE_WEEK = 7 * 24 * 60 * 60 * 1000;
  const oneWeekAgo = Date.now() - ONE_WEEK;
  const fresh = candidates
    .filter((p) => p.data.date.getTime() >= oneWeekAgo)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  if (fresh.length > 0) return fresh[0];

  const explicit = candidates.find((p) => p.data.featured);
  if (explicit) return explicit;

  const weeksSinceEpoch = Math.floor(Date.now() / ONE_WEEK);
  return candidates[weeksSinceEpoch % candidates.length];
}

const featured = pickFeatured(homepageCandidates);
const plan = homepagePlan(homepageCandidates, featured?.id);
const href = (p: (typeof homepageCandidates)[number]) => `/insights/${p.id}`;
const card = (p: (typeof homepageCandidates)[number]) => ({ href: href(p), title: p.data.title, date: p.data.date, cover: p.data.coverImage });
// Map points: every homepage essay, newest first; the lead essay goes first so it gets the ring.
const points = [plan.lead, ...homepageCandidates.filter((p) => p.id !== plan.lead.id)].map((p) => ({
  s: p.id, t: p.data.title.replace(/^📌\s*/u, ''), d: p.data.date.toISOString(), c: themeOf(p.data),
}));
---

<BaseLayout
  title="Signal to Noise — Finance, AI, and Capital Strategy by Himanshu Kher"
  description="Pragmatic essays on finance, AI, and capital strategy from a CFO with 25+ years in the field. Signal, not noise."
>
  <HomeHero lead={{ href: href(plan.lead), title: plan.lead.data.title, excerpt: plan.lead.data.excerpt, date: plan.lead.data.date }} points={points} />

  <TrackerStrip />

  <section class="mx-auto max-w-[1100px] px-6 py-14 grid gap-12">
    <ThemeRail title="Latest" items={plan.latest.map(card)} allHref="/insights" />
    {plan.rails.map((r) => <ThemeRail title={r.theme.label} color={r.theme.color} items={r.items.map(card)} allHref={r.theme.all} />)}
  </section>

  <section class="mx-auto max-w-[1100px] px-6 py-16" data-reveal>
    <h2 class="text-2xl font-semibold tracking-tight text-fg mb-8">Reading the noise</h2>
    <div class="max-w-[720px] space-y-6 text-lg text-fg leading-relaxed">
      <p>
        If you make decisions about money inside a company, this is for you.
      </p>
      <p>
        I'm a working CFO writing candid field notes on AI, capital strategy, leadership
        and FP&amp;A storytelling — without the buzzwords. Most weeks, one idea from the
        real world of boards, budgets and bets that can help you make fewer expensive
        mistakes.
      </p>
      <p>
        This site exists because most finance content is one of two things: a quarterly
        earnings rehash, or a hot take with no model behind it. The first is data without
        thinking. The second is thinking without data. Signal-to-noise sits in the middle:
        practical, operator-level thinking from someone who signs off on the numbers.
      </p>
      <p>
        Lately that has meant going back to first principles on where the money actually
        goes. An <a
          href="/insights/tag/buffett"
          class="text-accent hover:text-accent-hover transition-colors"
        >ongoing series</a> reads Buffett's letters not as scripture but as an operating
        manual — capital allocation as the CFO's real job, and why the balance sheet you
        can't kill beats the one you've optimised. In <a
          href="/insights/tag/ask-warren"
          class="text-accent hover:text-accent-hover transition-colors"
        >Ask Warren</a>, I take a question a board is asking this quarter and run it
        through that framework to see what survives.
      </p>
      <p class="pt-2">
        <a
          href="/about"
          class="text-accent hover:text-accent-hover transition-colors"
        >
          More about me →
        </a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1100px] px-6 py-16 mb-12" data-reveal>
    <h2 class="text-2xl font-semibold tracking-tight text-fg mb-6">Get in touch</h2>
    <p class="text-muted mb-6 max-w-[720px]">
      Working on something at the edges of finance and tech? I'd like to hear about it.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="/contact"
        class="inline-flex items-center px-5 py-3 rounded-md bg-accent text-canvas font-medium hover:shadow-[0_0_28px_rgba(255,255,255,0.3)] transition-all duration-300"
      >
        Contact →
      </a>
      <a
        href="/subscribe"
        class="inline-flex items-center px-5 py-3 rounded-md border border-divider text-fg font-medium hover:border-accent/40 hover:text-accent transition-all duration-300"
      >
        Subscribe →
      </a>
    </div>
  </section>
</BaseLayout>
