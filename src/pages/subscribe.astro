---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
---

<BaseLayout
  title="Subscribe — signal-to-noise.co"
  description="One essay a week, on Wednesdays, here and on LinkedIn. Field notes on finance, AI, and capital strategy from a working CFO. Leave your email to join the list; nothing is sent for now."
>
  <article class="mx-auto max-w-[720px] px-6 py-16 sm:py-24">
    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-accent mb-6">Subscribe</p>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight text-fg">
        Join the list.
      </h1>
    </header>

    <div class="space-y-8 text-lg text-fg leading-relaxed">
      <p>
        Field notes on finance, AI, and capital strategy from a working CFO.
        One new essay every Wednesday, here and on LinkedIn.
      </p>

      <SubscribeForm location="subscribe-page" framed={false} />
    </div>
  </article>
</BaseLayout>
