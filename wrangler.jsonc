{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signal-to-noise-subscribe",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Static site stays on the GCE origin. This Worker claims only the signup
  // path. The trailing * is required: route matching includes the query
  // string, and a pattern without it misses POSTs that carry one.
  // workers.dev stays off so the API key is not reachable on a second host.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "signal-to-noise.co/api/subscribe*",
      "zone_name": "signal-to-noise.co"
    },
    {
      "pattern": "www.signal-to-noise.co/api/subscribe*",
      "zone_name": "signal-to-noise.co"
    }
  ]
}
